# API keys are optional here — the extension's settings panel stores them in
# config.json instead. These environment variables are the fallback, used when
# a provider has no key saved in settings.
#
# Copy to .env and fill in whichever provider(s) you use.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
CUSTOM_API_KEY=
