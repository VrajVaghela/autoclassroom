{
  "manifest_version": 3,
  "name": "AutoClassroom",
  "version": "2.0",
  "description": "Generate and save complete Google Classroom assignment solutions with your choice of AI.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoClassroom",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "popup.html",
  "host_permissions": [
    "*://classroom.google.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://*/*"
  ]
}
